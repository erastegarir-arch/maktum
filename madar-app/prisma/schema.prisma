// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------
// جدول تنظیمات هسته سایت
// ------------------------------------------------
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول مدیریت فایل‌ها و رسانه‌ها
// ------------------------------------------------
model Media {
  id        String   @id @default(cuid())
  url       String
  fileType  String
  mimeType  String
  size      Int
  title     String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول کتابخانه آیکون‌های داینامیک
// ------------------------------------------------
model IconLibrary {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  svgCode   String
  createdAt DateTime @default(now())
}

// ------------------------------------------------
// جدول کدهای تایید یکبار مصرف (OTP)
// ------------------------------------------------
model OtpCode {
  id        String   @id @default(cuid())
  phone     String   @unique // شماره موبایل کاربر
  code      String   // کد ۵ یا ۶ رقمی پیامک شده
  expiresAt DateTime // زمان انقضای کد
  attempts  Int      @default(0) // تعداد تلاش‌های ناموفق برای جلوگیری از بروت‌فورس
  createdAt DateTime @default(now())
}

// ------------------------------------------------
// مدیریت کاربران و سطوح دسترسی (User Management & RBAC)
// ------------------------------------------------
enum UserStatus {
  ACTIVE // فعال
  BANNED // مسدود شده توسط ادمین
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id       String     @id @default(cuid())
  phone    String     @unique
  password String?    // رمز عبور اصلی حساب کاربری (هش‌شده)
  status   UserStatus @default(ACTIVE)

  // اطلاعات پروفایل (قابل ویرایش توسط کاربر)
  firstName            String?
  lastName             String?
  gender               Gender?
  birthYear            String? // ذخیره تاریخ شمسی به صورت رشته
  province             String?
  city                 String?
  educationDegree      String? // مدرک تحصیلی
  major                String? // رشته تحصیلی
  artResearchField     String? // حوزه فعالیت هنری / پژوهشی
  cooperationInterests String? // زمینه‌های تمایل به همکاری
  email                String?

  // سیستم دسترسی چک‌لیستی (مدل تلگرامی) و امنیت مدیران
  isSuperAdmin     Boolean @default(false) // مدیر کل ارشد (غیرقابل تغییر، محدودسازی یا مسدودسازی توسط هیچ مدیری)
  isAdmin          Boolean @default(false) // فلگ تفکیک‌کننده مدیران از کاربران عادی برای فیلتر سریع
  adminPermissions String? // آرایه مجوزهای دانه‌ریز به صورت JSON String (مثال: ["CONTENT_CREATE", "CONTENT_EDIT"])
  adminPassword    String? // رمز عبور دوم ویژه ورود و عملیات مدیریتی (هش‌شده)

  // روابط با سایر جداول
  favorites     Favorite[]
  downloads     DownloadHistory[]
  notifications UserNotification[]
  comments      Comment[] // ارتباط کاربر با نظراتش
  searchLogs    SearchLog[] // تاریخچه سرچ‌های این کاربر

  createdAt DateTime @default(now()) // تاریخ عضویت غیرقابل ویرایش
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// سیستم جامع اعلان‌ها (Notifications)
// ------------------------------------------------
enum NotificationType {
  SYSTEM  // اعلان‌های خودکار سیستم (مثل خوشامدگویی)
  BULK    // ارسال گروهی، فیلتردار یا دستی توسط ادمین
  PRIVATE // پیام اختصاصی فقط برای یک شخص یا عده‌ای خاص
}

model Notification {
  id String @id @default(cuid())

  // تنظیمات کلان و اتوماسیون
  type         NotificationType @default(BULK)
  isTemplate   Boolean          @default(false)
  triggerEvent String?          @unique
  isActive     Boolean          @default(true)

  // ۱. محتوای درون‌سایتی (In-App Rich Payload)
  sendInApp  Boolean @default(true)
  title      String?
  bodyHtml   String?
  themeColor String?
  iconUrl    String?
  coverUrl   String?
  ctaButtons String?

  // ۲. محتوای پیامکی (SMS Payload)
  sendSms Boolean @default(false)
  smsText String?

  // ۳. آمار و گزارش‌گیری (Analytics)
  targetCount  Int @default(0)
  smsSentCount Int @default(0)
  smsFailCount Int @default(0)
  readCount    Int @default(0)

  userNotifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, notificationId])
}

// ------------------------------------------------
// علاقه‌مندی‌ها و دانلودهای کاربر
// ------------------------------------------------
model Favorite {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  createdAt DateTime @default(now())

  @@unique([userId, contentId])
}

model DownloadHistory {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  downloadedAt DateTime @default(now())
}

// ------------------------------------------------
// تعریف انواع سرشاخه‌ها (Taxonomy Types)
// ------------------------------------------------
enum TaxonomyType {
  CATEGORY // دسته‌بندی
  HASHTAG  // هشتگ
  CREATOR  // پدیدآورنده
}

model Taxonomy {
  id   String       @id @default(cuid())
  type TaxonomyType

  name String
  slug String

  preTitle    String?
  description String?
  imageUrl    String?

  metaTitle String?
  metaDesc  String?

  categoryContents Content[] @relation("ContentCategories")
  creatorContents  Content[] @relation("ContentCreators")
  tagContents      Content[] @relation("ContentTags")

  dossiers Dossier[] @relation("DossierTaxonomies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@unique([type, slug])
}

// ------------------------------------------------
// Enums محتوا و پرونده‌ها
// ------------------------------------------------
enum ContentType {
  RAW      // محتوای خام
  PRODUCED // محتوای تولیدی
  TOOL     // ابزارها
  BLOG     // بلاگ
}

enum ContentStatus {
  DRAFT     // پیش‌نویس
  PUBLISHED // منتشر شده
  ARCHIVED  // بایگانی
}

// ================================================
// مدل: پرونده‌های ویژه (Curated Dossiers / Hubs)
// ================================================
model Dossier {
  id   String @id @default(cuid())
  slug String @unique

  metaTitle       String?
  metaDesc        String?
  hubCoverDesktop String?
  hubCoverMobile  String?
  isVisibleInHub  Boolean @default(true)
  orderIndex      Int     @default(0)
  layoutSize      String? @default("STANDARD")

  preTitle     String?
  title        String
  description  String?
  coverDesktop String?
  coverMobile  String?

  themeColor         String? @default("#06b6d4")
  gradientFrom       String? @default("#06b6d4")
  gradientTo         String? @default("#d946ef")
  titleGradientStart String? @default("#ffffff")
  titleGradientEnd   String? @default("#ffffff")
  preTitleColor      String? @default("#a3a3a3")
  descColor          String? @default("#d1d5db")

  showRadar  Boolean @default(true)
  radarTitle String? @default("رادار موضوعی پرونده")

  showCreators  Boolean @default(true)
  creatorsTitle String? @default("اشخاص و پدیدآورندگان مرتبط")

  showTipLine Boolean @default(true)
  tipPreTitle String? @default("پورتال ارتباط امن")
  tipTitle    String? @default("سندی در دست دارید؟")
  tipDesc     String?
  tipBtnText  String? @default("ارسال امن سند")
  tipBtnLink  String? @default("#")
  tipBtnIcon  String? @default("upload")

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @default(now())
  viewCount   Int           @default(0)

  contents   Content[]  @relation("DossierContents")
  taxonomies Taxonomy[] @relation("DossierTaxonomies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// مدل اصلی محتوا
// ------------------------------------------------
model Content {
  id String @id @default(cuid())

  titleBase      String
  titleHighlight String?
  subtitle       String?
  slug           String  @unique

  type   ContentType
  status ContentStatus @default(DRAFT)

  coverDesktop String?
  coverMobile  String?

  publishedAt DateTime? @default(now())
  readTime    String?
  ageRating   String?
  viewCount   Int       @default(0)

  metaTitle String?
  metaDesc  String?

  displaySettings Json?

  body          String?
  allowComments Boolean @default(true)

  lead String?

  formats        Json?
  previews       Json?
  previewGallery Json?
  fileSpecs      Json?
  changelog      Json?
  downloadLinks  Json?

  categories Taxonomy[] @relation("ContentCategories")
  creators   Taxonomy[] @relation("ContentCreators")
  tags       Taxonomy[] @relation("ContentTags")

  dossiers Dossier[] @relation("DossierContents")

  favoritedBy  Favorite[]
  downloadedBy DownloadHistory[]
  comments     Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================================================
// جداول سیستم تعاملات و نظرات
// ================================================
enum CommentStatus {
  PENDING  // در انتظار تایید
  APPROVED // تایید شده و قابل نمایش
  REJECTED // رد شده
}

model Comment {
  id     String        @id @default(cuid())
  text   String
  status CommentStatus @default(PENDING)

  adminReply String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول ذخیره آمار جستجوهای کاربران (Search Analytics)
// ------------------------------------------------
model SearchLog {
  id           String   @id @default(cuid())
  keyword      String
  resultsCount Int
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
}
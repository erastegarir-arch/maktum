// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------
// جدول تنظیمات هسته سایت
// ------------------------------------------------
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول مدیریت فایل‌ها و رسانه‌ها
// ------------------------------------------------
model Media {
  id        String   @id @default(cuid())
  url       String
  fileType  String
  mimeType  String
  size      Int
  title     String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول کتابخانه آیکون‌های داینامیک
// ------------------------------------------------
model IconLibrary {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  svgCode   String
  createdAt DateTime @default(now())
}

// ------------------------------------------------
// تعریف انواع سرشاخه‌ها (Taxonomy Types)
// ------------------------------------------------
enum TaxonomyType {
  CATEGORY   // دسته‌بندی
  HASHTAG    // هشتگ
  CREATOR    // پدیدآورنده
}

model Taxonomy {
  id          String       @id @default(cuid())
  type        TaxonomyType // نوع: دسته‌بندی، هشتگ یا پدیدآورنده
  
  name        String       // نام (مثل: تاریخ)
  slug        String       // لینک انگلیسی (مثل: history)
  
  preTitle    String?      // روتیتر (باکس بالای عنوان)
  description String?      // توضیحات
  imageUrl    String?      // تصویر پروفایل (مخصوص پدیدآورنده)

  // سئو (متا)
  metaTitle   String?
  metaDesc    String?

  // روابط معکوس چندگانه با جدول محتوا
  categoryContents Content[] @relation("ContentCategories")
  creatorContents  Content[] @relation("ContentCreators")
  tagContents      Content[] @relation("ContentTags")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // قوانین یکتا بودن نام و اسلاگ در هر نوع سرشاخه
  @@unique([type, name])
  @@unique([type, slug])
}

// ------------------------------------------------
// Enums محتوا
// ------------------------------------------------
enum ContentType {
  RAW         // محتوای خام
  PRODUCED    // محتوای تولیدی
  TOOL        // ابزارها
  BLOG        // بلاگ
}

enum ContentStatus {
  DRAFT       // پیش‌نویس
  PUBLISHED   // منتشر شده
  ARCHIVED    // بایگانی
}

// ------------------------------------------------
// مدل اصلی محتوا
// ------------------------------------------------
model Content {
  id              String        @id @default(cuid())
  
  // فیلدهای متنی و پایه
  titleBase       String        // نیمه اول عنوان (سفید)
  titleHighlight  String?       // نیمه دوم عنوان (رنگی)
  subtitle        String?       // زیرعنوان
  slug            String        @unique // پیوند یکتا
  
  // نوع و وضعیت
  type            ContentType
  status          ContentStatus @default(DRAFT)
  
  // تصاویر شاخص
  coverDesktop    String?       // کاور کامپیوتر
  coverMobile     String?       // کاور موبایل
  
  // متادیتا و آمار
  publishedAt     DateTime?     @default(now()) // تاریخ انتشار
  readTime        String?       // زمان مطالعه
  ageRating       String?       // رده‌بندی سنی
  viewCount       Int           @default(0)     // تعداد بازدید
  
  // سئو (Meta SEO)
  metaTitle       String?       // عنوان سئو
  metaDesc        String?       // توضیحات متا سئو

  // تنظیمات تاگل‌های نمایش (JSON)
  displaySettings Json?         // وضعیت فعال/غیرفعال بودن نمایش المان‌ها در صفحه

  // محتوای اصلی
  body            String?       // متن اصلی ادیتور (معرفی / متن خبر)
  allowComments   Boolean       @default(true)  // امکان ثبت نظر
  
  // فیلدهای اختصاصی بلاگ
  lead            String?       // لید خبر
  
  // فیلدهای پویا (JSON) برای محصولات و ابزارها
  formats         Json?         // فرمت‌های ارائه شده
  previews        Json?         // پیش‌نمایش کلی (اختیاری)
  previewGallery  Json?         // گالری پیش‌نمایش چندگانه (فیلم، عکس، صوت)
  fileSpecs       Json?         // مشخصات فایل
  changelog       Json?         // تاریخچه به‌روزرسانی‌ها
  downloadLinks   Json?         // لینک‌های دانلود

  // روابط چندگانه با جدول سرشاخه‌ها (Taxonomy)
  categories      Taxonomy[]    @relation("ContentCategories")
  creators        Taxonomy[]    @relation("ContentCreators")
  tags            Taxonomy[]    @relation("ContentTags")

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
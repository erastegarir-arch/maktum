// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------
// جدول تنظیمات هسته سایت
// ------------------------------------------------
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول مدیریت فایل‌ها و رسانه‌ها
// ------------------------------------------------
model Media {
  id        String   @id @default(cuid())
  url       String
  fileType  String
  mimeType  String
  size      Int
  title     String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول کتابخانه آیکون‌های داینامیک
// ------------------------------------------------
model IconLibrary {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  svgCode   String
  createdAt DateTime @default(now())
}

// ------------------------------------------------
// مدیریت کاربران و سطوح دسترسی (User Management & RBAC)
// ------------------------------------------------
enum UserStatus {
  ACTIVE // فعال
  BANNED // مسدود شده توسط ادمین
}

enum Gender {
  MALE
  FEMALE
}

model User {
  id      String     @id @default(cuid())
  phone   String     @unique
  status  UserStatus @default(ACTIVE)

  // اطلاعات پروفایل (قابل ویرایش توسط کاربر)
  firstName          String?
  lastName           String?
  gender             Gender?
  birthYear          String? // به صورت رشته نگه می‌داریم تا تاریخ شمسی مانند "1361" به سادگی ذخیره شود
  province           String?
  city               String?
  educationDegree    String? // مدرک تحصیلی
  major              String? // رشته تحصیلی
  artResearchField   String? // حوزه فعالیت هنری / پژوهشی
  cooperationInterests String? // زمینه‌های تمایل به همکاری
  email              String?

  // سیستم دسترسی مبتنی بر نقش (RBAC)
  roleId  String?
  role    Role?   @relation(fields: [roleId], references: [id])

  // روابط با سایر جداول
  favorites     Favorite[]
  downloads     DownloadHistory[]
  notifications UserNotification[]
  comments      Comment[] // <--- اضافه شده برای ارتباط کاربر با نظراتش

  createdAt DateTime @default(now()) // همان تاریخ عضویت غیرقابل ویرایش
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// جدول نقش‌ها (سطوح دسترسی مدیریتی)
// ------------------------------------------------
model Role {
  id          String  @id @default(cuid())
  name        String  @unique // مثال: "سردبیر"
  slug        String  @unique // مثال: "editor"
  permissions String  // ذخیره آرایه مجوزها به صورت رشته متنی (JSON String)
  isSystem    Boolean @default(false) // برای جلوگیری از حذف نقش‌های اصلی

  users User[] // ارتباط با کاربران

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// سیستم جامع اعلان‌ها (Notifications)
// ------------------------------------------------
enum NotificationType {
  SYSTEM // اعلان‌های خودکار سیستم (مثل خوشامدگویی)
  BULK   // ارسال گروهی، فیلتردار یا دستی توسط ادمین
  PRIVATE // پیام اختصاصی فقط برای یک شخص یا عده‌ای خاص
}

// بدنه اصلی پیام (یکپارچه برای سایت و پیامک)
model Notification {
  id String @id @default(cuid())

  // تنظیمات کلان و اتوماسیون
  type         NotificationType @default(BULK)
  isTemplate   Boolean          @default(false) // در صورت فعال بودن، یک قالب سیستمی است
  triggerEvent String?          @unique // شناسه اتوماسیون (مثال: WELCOME, BIRTHDAY, COMMENT_REPLY)
  isActive     Boolean          @default(true) // امکان فعال/غیرفعال کردن ارسال اتوماتیک

  // ۱. محتوای درون‌سایتی (In-App Rich Payload)
  sendInApp  Boolean @default(true)
  title      String? // عنوان اعلان
  bodyHtml   String? // توضیحات با ادیتور پیشرفته (Rich Text)
  themeColor String? // انتخاب تم رنگی (مثلاً #10b981)
  iconUrl    String? // آیکون انتخابی از کتابخانه رسانه
  coverUrl   String? // تصویر بنر اعلان از کتابخانه رسانه
  ctaButtons String? // باکس لینک‌دار (آرایه دکمه‌ها ذخیره شده به صورت JSON String)

  // ۲. محتوای پیامکی (SMS Payload)
  sendSms  Boolean @default(false) // آیا پیامک ارسال شود؟
  smsText  String? // متن خام پیامک (با پشتیبانی از کاراکتر و ایموجی)

  // ۳. آمار و گزارش‌گیری (Analytics)
  targetCount  Int @default(0) // کل کاربرانی که در لیست ارسال بوده‌اند
  smsSentCount Int @default(0) // پیامک‌های موفق کاوه‌نگار
  smsFailCount Int @default(0) // پیامک‌های ناموفق
  readCount    Int @default(0) // تعداد کاربرانی که اعلان را در سایت دیده‌اند

  userNotifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// وضعیت خوانده شدن پیام به ازای هر کاربر
model UserNotification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String

  isRead  Boolean   @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now()) // زمان دقیق ایجاد این رکورد برای این کاربر خاص

  @@unique([userId, notificationId]) // هر کاربر فقط یک نسخه از هر اعلان دارد
}

// ------------------------------------------------
// علاقه‌مندی‌ها و دانلودهای کاربر
// ------------------------------------------------
model Favorite {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  createdAt DateTime @default(now())

  @@unique([userId, contentId]) // جلوگیری از لایک تکراری برای یک محصول
}

model DownloadHistory {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  downloadedAt DateTime @default(now())
}

// ------------------------------------------------
// تعریف انواع سرشاخه‌ها (Taxonomy Types)
// ------------------------------------------------
enum TaxonomyType {
  CATEGORY // دسته‌بندی
  HASHTAG  // هشتگ
  CREATOR  // پدیدآورنده
}

model Taxonomy {
  id   String        @id @default(cuid())
  type TaxonomyType // نوع: دسته‌بندی، هشتگ یا پدیدآورنده

  name String // نام (مثل: تاریخ)
  slug String // لینک انگلیسی (مثل: history)

  preTitle    String? // روتیتر (باکس بالای عنوان)
  description String? // توضیحات
  imageUrl    String? // تصویر پروفایل (مخصوص پدیدآورنده)

  // سئو (متا)
  metaTitle String?
  metaDesc  String?

  // روابط معکوس چندگانه با جدول محتوا
  categoryContents Content[] @relation("ContentCategories")
  creatorContents  Content[] @relation("ContentCreators")
  tagContents      Content[] @relation("ContentTags")

  // اتصال سرشاخه‌ها به پرونده‌های ویژه
  dossiers Dossier[] @relation("DossierTaxonomies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // قوانین یکتا بودن نام و اسلاگ در هر نوع سرشاخه
  @@unique([type, name])
  @@unique([type, slug])
}

// ------------------------------------------------
// Enums محتوا و پرونده‌ها
// ------------------------------------------------
enum ContentType {
  RAW      // محتوای خام
  PRODUCED // محتوای تولیدی
  TOOL     // ابزارها
  BLOG     // بلاگ
}

enum ContentStatus {
  DRAFT     // پیش‌نویس
  PUBLISHED // منتشر شده
  ARCHIVED  // بایگانی
}

// ================================================
// مدل: پرونده‌های ویژه (Curated Dossiers / Hubs)
// ================================================
model Dossier {
  id   String @id @default(cuid())
  slug String @unique // لینک یکتا برای دامنه /c/[slug]

  // 1. اطلاعات سئو و نمایش در صفحه اصلی (Hub)
  metaTitle       String?
  metaDesc        String?
  hubCoverDesktop String? // کاور 16:9 برای صفحه اصلی
  hubCoverMobile  String? // کاور 1:1 برای صفحه اصلی
  isVisibleInHub  Boolean @default(true) // نمایش در صفحه اصلی؟
  orderIndex      Int     @default(0) // ترتیب چینش با درگ و دراپ
  
  // ------------------------------------
  // فیلد اضافه‌شده: وضعیت چیدمان (گرید) در هاب
  layoutSize      String? @default("STANDARD") // VIP | STANDARD
  // ------------------------------------

  // 2. هدر صفحه داخلی (Hero Section)
  preTitle     String? // روتیتر (مثلاً: اسناد محرمانه سفارت)
  title        String // عنوان اصلی
  description  String? // توضیح دو خطی
  coverDesktop String? // کاور واید هدر (16:9)
  coverMobile  String? // کاور هدر موبایل (1:1)

  // تنظیمات گرافیکی و رنگ‌بندی جدید
  themeColor          String? @default("#06b6d4") // رنگ اصلی نئون
  gradientFrom        String? @default("#06b6d4") // رنگ قدیمی (جهت سازگاری)
  gradientTo          String? @default("#d946ef") // رنگ قدیمی (جهت سازگاری)
  // ------------------------------------
  // فیلدهای اضافه‌شده: رنگ‌بندی داینامیک متون
  titleGradientStart  String? @default("#ffffff")
  titleGradientEnd    String? @default("#ffffff")
  preTitleColor       String? @default("#a3a3a3")
  descColor           String? @default("#d1d5db")
  // ------------------------------------

  // 3. رادار موضوعی
  showRadar  Boolean @default(true)
  radarTitle String? @default("رادار موضوعی پرونده")

  // 4. پدیدآورندگان
  showCreators  Boolean @default(true)
  creatorsTitle String? @default("اشخاص و پدیدآورندگان مرتبط")

  // 5. اقدام به عمل (Tip Line / ارتباط امن)
  showTipLine Boolean @default(true)
  tipPreTitle String? @default("پورتال ارتباط امن")
  tipTitle    String? @default("سندی در دست دارید؟")
  tipDesc     String?
  tipBtnText  String? @default("ارسال امن سند")
  tipBtnLink  String? @default("#")
  tipBtnIcon  String? @default("upload")

  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @default(now())
  viewCount   Int           @default(0)

  // روابط جادویی (چند به چند): اتصال پرونده به محتواها و سرشاخه‌های دیگر
  contents   Content[]  @relation("DossierContents")
  taxonomies Taxonomy[] @relation("DossierTaxonomies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------
// مدل اصلی محتوا
// ------------------------------------------------
model Content {
  id String @id @default(cuid())

  // فیلدهای متنی و پایه
  titleBase      String // نیمه اول عنوان (سفید)
  titleHighlight String? // نیمه دوم عنوان (رنگی)
  subtitle       String? // زیرعنوان
  slug           String  @unique // پیوند یکتا

  // نوع و وضعیت
  type   ContentType
  status ContentStatus @default(DRAFT)

  // تصاویر شاخص
  coverDesktop String? // کاور کامپیوتر
  coverMobile  String? // کاور موبایل

  // متادیتا و آمار
  publishedAt DateTime? @default(now()) // تاریخ انتشار
  readTime    String? // زمان مطالعه
  ageRating   String? // رده‌بندی سنی
  viewCount   Int       @default(0) // تعداد بازدید

  // سئو (Meta SEO)
  metaTitle String? // عنوان سئو
  metaDesc  String? // توضیحات متا سئو

  // تنظیمات تاگل‌های نمایش (JSON)
  displaySettings Json? // وضعیت فعال/غیرفعال بودن نمایش المان‌ها در صفحه

  // محتوای اصلی
  body          String? // متن اصلی ادیتور (معرفی / متن خبر)
  allowComments Boolean @default(true) // امکان ثبت نظر

  // فیلدهای اختصاصی بلاگ
  lead String? // لید خبر

  // فیلدهای پویا (JSON) برای محصولات و ابزارها
  formats        Json? // فرمت‌های ارائه شده
  previews       Json? // پیش‌نمایش کلی (اختیاری)
  previewGallery Json? // گالری پیش‌نمایش چندگانه (فیلم، عکس، صوت)
  fileSpecs      Json? // مشخصات فایل
  changelog      Json? // تاریخچه به‌روزرسانی‌ها
  downloadLinks  Json? // لینک‌های دانلود

  // روابط با سرشاخه‌ها
  categories Taxonomy[] @relation("ContentCategories")
  creators   Taxonomy[] @relation("ContentCreators")
  tags       Taxonomy[] @relation("ContentTags")

  // اتصال محتوا به پرونده‌های ویژه
  dossiers Dossier[] @relation("DossierContents")

  // روابط با تعاملات کاربر
  favoritedBy  Favorite[]
  downloadedBy DownloadHistory[]
  comments     Comment[] // ارتباط محتوا با نظرات

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ================================================
// جداول سیستم تعاملات و نظرات
// ================================================

enum CommentStatus {
  PENDING  // در انتظار تایید
  APPROVED // تایید شده و قابل نمایش
  REJECTED // رد شده
}

model Comment {
  id      String        @id @default(cuid())
  text    String // متن نظر کاربر
  status  CommentStatus @default(PENDING) // وضعیت تایید نظر

  adminReply String? // فیلد پاسخ مستقیم ادمین (ساختار تخت و بهینه)

  // ارتباط با کاربر (نویسنده نظر)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // ارتباط با محتوای مورد نظر
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------
// جدول تنظیمات هسته سامانه
// ------------------------------------------------
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String
  updatedAt DateTime @updatedAt

  // ایندکس برای واکشی سریع تنظیمات یک گروه خاص
  @@index([group])
}

// ------------------------------------------------
// جدول مسئولیت پرونده‌ها و رسانه‌ها
// ------------------------------------------------
model Media {
  id        String   @id @default(cuid())
  url       String
  fileType  String
  mimeType  String
  size      Int
  title     String?
  altText   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ایندکس‌های فیلترینگ کتابخانه رسانه در پنل مدیریت
  @@index([fileType, createdAt(sort: Desc)])
  @@index([mimeType])
  @@index([createdAt(sort: Desc)])
}

// ------------------------------------------------
// جدول کتابخانه نماد‌های پویا
// ------------------------------------------------
model IconLibrary {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  svgCode   String
  createdAt DateTime @default(now())

  // ایندکس برای جستجوی سریع برچسب آیکون‌ها
  @@index([label])
}

// ------------------------------------------------
// جدول کدهای تایید یکبار مصرف (OTP) - موقت برای اعتبارسنجی زنده
// ------------------------------------------------
model OtpCode {
  id        String   @id @default(cuid())
  phone     String   @unique // شماره موبایل کاربر
  code      String   // کد ۵ یا ۶ رقمی پیامک شده
  expiresAt DateTime // زمان انقضای کد
  attempts  Int      @default(0) // تعداد تلاش‌های ناموفق برای جلوگیری از بروت‌فورس
  createdAt DateTime @default(now())

  // ایندکس برای پاکسازی سریع کدهای منقضی‌شده و بررسی نرخ درخواست
  @@index([expiresAt])
  @@index([createdAt])
}

// ------------------------------------------------
// مسئولیت کاربران و سطوح دسترسی (User Management & RBAC)
// ------------------------------------------------
model User {
  id       String  @id @default(cuid())
  phone    String  @unique
  password String? // گذرواژه اصلی حساب کاربری (هش‌شده)
  status   String  @default("ACTIVE") // جایگزین enum UserStatus

  // اطلاعات نماگر (قابل ویرایش توسط کاربر)
  firstName            String?
  lastName             String?
  gender               String? // جایگزین enum Gender
  birthYear            String? // ذخیره تاریخ شمسی به صورت رشته
  province             String?
  city                 String?
  educationDegree      String? // مدرک تحصیلی
  major                String? // رشته تحصیلی
  artResearchField     String? // حوزه فعالیت هنری / پژوهشی
  cooperationInterests String? // زمینه‌های تمایل به همکاری
  email                String?

  // نظام دسترسی فهرست بررسی و امنیت مسئولان
  isSuperAdmin     Boolean @default(false) // مسئول کل ارشد (غیرقابل تغییر، محدودسازی یا مسدودسازی توسط هیچ مسئولی)
  isAdmin          Boolean @default(false) // فلگ تفکیک‌کننده مسئولان از کاربران عادی برای صافی سریع
  adminPermissions String? // آرایه مجوزهای دانه‌ریز به صورت JSON String (مثال: ["CONTENT_CREATE", "CONTENT_EDIT"])
  adminPassword    String? // گذرواژه دوم ویژه ورود و عملیات مسئولیتی (هش‌شده)

  // روابط با سایر جداول
  favorites     Favorite[]
  downloads     DownloadHistory[]
  notifications UserNotification[]
  comments      Comment[] // ارتباط کاربر با نظراتش
  searchLogs    SearchLog[] // تاریخچه کاوش‌های این کاربر

  createdAt DateTime @default(now()) // تاریخ عضویت غیرقابل ویرایش
  updatedAt DateTime @updatedAt

  // ایندکس‌های ترکیبی برای پنل مدیریت، احراز هویت و گزارش‌گیری
  @@index([status, createdAt(sort: Desc)])
  @@index([isAdmin, isSuperAdmin])
  @@index([email])
  @@index([province, city])
  @@index([createdAt(sort: Desc)])
}

// ------------------------------------------------
// نظام جامع اعلان‌ها (Notifications)
// ------------------------------------------------
model Notification {
  id String @id @default(cuid())

  // تنظیمات کلان و اتوماسیون
  type         String  @default("BULK") // جایگزین enum NotificationType
  isTemplate   Boolean @default(false)
  triggerEvent String? @unique
  isActive     Boolean @default(true)

  // ۱. محتوای درون‌سامانه‌ای (In-App Rich Payload)
  sendInApp  Boolean @default(true)
  title      String?
  bodyHtml   String?
  themeColor String?
  iconUrl    String?
  coverUrl   String?
  ctaButtons String?

  // ۲. محتوای پیامکی (SMS Payload)
  sendSms Boolean @default(false)
  smsText String?

  // ۳. آمار و گزارش‌گیری (Analytics)
  targetCount  Int @default(0)
  smsSentCount Int @default(0)
  smsFailCount Int @default(0)
  readCount    Int @default(0)

  userNotifications UserNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ایندکس‌های فیلترینگ اعلان‌ها و قالب‌های سامانه‌ای
  @@index([type, isActive, createdAt(sort: Desc)])
  @@index([isTemplate, isActive])
}

model UserNotification {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, notificationId])
  // ایندکس حیاتی برای شمارش و نمایش اعلان‌های خوانده‌نشده کاربر در هدر سایت
  @@index([userId, isRead, createdAt(sort: Desc)])
  // ایندکس کلید خارجی برای جلوگیری از قفل شدن جدول هنگام حذف یک Notification
  @@index([notificationId])
}

// ------------------------------------------------
// علاقه‌مندی‌ها و بارگیری‌های کاربر
// ------------------------------------------------
model Favorite {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  createdAt DateTime @default(now())

  @@unique([userId, contentId])
  // ایندکس برای فهرست علاقه‌مندی‌های کاربر به ترتیب جدیدترین
  @@index([userId, createdAt(sort: Desc)])
  // ایندکس کلید خارجی برای شمارش علاقه‌مندی‌های یک محتوا و Cascade Delete
  @@index([contentId])
}

model DownloadHistory {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  downloadedAt DateTime @default(now())

  // ایندکس بررسی اسپم دانلود (آیا کاربر اخیراً همین پرونده را دانلود کرده است؟)
  @@index([userId, contentId, downloadedAt(sort: Desc)])
  // ایندکس نمایش تاریخچه دانلود کاربر
  @@index([userId, downloadedAt(sort: Desc)])
  // ایندکس آمار دانلود هر محتوا و Cascade Delete
  @@index([contentId, downloadedAt(sort: Desc)])
  // ایندکس برای Cron Job پاکسازی لاگ‌های قدیمی
  @@index([downloadedAt])
}

// ------------------------------------------------
// تعریف انواع سرشاخه‌ها (Taxonomy Types)
// ------------------------------------------------
model Taxonomy {
  id   String @id @default(cuid())
  type String // جایگزین enum TaxonomyType

  name String
  slug String

  preTitle    String?
  description String?
  imageUrl    String?

  metaTitle String?
  metaDesc  String?

  categoryContents Content[] @relation("ContentCategories")
  creatorContents  Content[] @relation("ContentCreators")
  tagContents      Content[] @relation("ContentTags")

  dossiers Dossier[] @relation("DossierTaxonomies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, name])
  @@unique([type, slug])
  // ایندکس برای جستجوی مستقیم با اسلاگ و فهرست‌بندی بر اساس نوع
  @@index([slug])
  @@index([type, createdAt(sort: Desc)])
}

// ================================================
// مدل: پرونده‌های ویژه (Curated Dossiers / Hubs)
// ================================================
model Dossier {
  id   String @id @default(cuid())
  slug String @unique

  metaTitle       String?
  metaDesc        String?
  hubCoverDesktop String?
  hubCoverMobile  String?
  isVisibleInHub  Boolean @default(true)
  orderIndex      Int     @default(0)
  layoutSize      String? @default("STANDARD")

  preTitle     String?
  title        String
  description  String?
  coverDesktop String?
  coverMobile  String?

  themeColor         String? @default("#06b6d4")
  gradientFrom       String? @default("#06b6d4")
  gradientTo         String? @default("#d946ef")
  titleGradientStart String? @default("#ffffff")
  titleGradientEnd   String? @default("#ffffff")
  preTitleColor      String? @default("#a3a3a3")
  descColor          String? @default("#d1d5db")

  showRadar  Boolean @default(true)
  radarTitle String? @default("رادار موضوعی پرونده")

  showCreators  Boolean @default(true)
  creatorsTitle String? @default("اشخاص و پدیدآورندگان مرتبط")

  showTipLine Boolean @default(true)
  tipPreTitle String? @default("پورتال ارتباط امن")
  tipTitle    String? @default("سندی در دست دارید؟")
  tipDesc     String?
  tipBtnText  String? @default("ارسال امن سند")
  tipBtnLink  String? @default("#")
  tipBtnIcon  String? @default("upload")

  status      String    @default("DRAFT") // جایگزین enum ContentStatus
  publishedAt DateTime? @default(now())
  viewCount   Int       @default(0)

  contents   Content[]  @relation("DossierContents")
  taxonomies Taxonomy[] @relation("DossierTaxonomies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ایندکس ترکیبی دقیق برای کوئری صفحه هاب پرونده‌ها
  @@index([status, isVisibleInHub, orderIndex(sort: Asc), publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([viewCount(sort: Desc)])
}

// ------------------------------------------------
// مدل اصلی محتوا
// ------------------------------------------------
model Content {
  id String @id @default(cuid())

  titleBase      String
  titleHighlight String?
  subtitle       String?
  slug           String  @unique

  type   String // جایگزین enum ContentType
  status String @default("DRAFT") // جایگزین enum ContentStatus

  coverDesktop String?
  coverMobile  String?

  publishedAt DateTime? @default(now())
  readTime    String?
  ageRating   String?
  viewCount   Int       @default(0)

  metaTitle String?
  metaDesc  String?

  displaySettings String? // جایگزین Json?

  body          String?
  allowComments Boolean @default(true)

  lead String?

  formats        String? // جایگزین Json?
  previews       String? // جایگزین Json?
  previewGallery String? // جایگزین Json?
  fileSpecs      String? // جایگزین Json?
  changelog      String? // جایگزین Json?
  downloadLinks  String? // جایگزین Json?

  categories Taxonomy[] @relation("ContentCategories")
  creators   Taxonomy[] @relation("ContentCreators")
  tags       Taxonomy[] @relation("ContentTags")

  dossiers Dossier[] @relation("DossierContents")

  favoritedBy  Favorite[]
  downloadedBy DownloadHistory[]
  comments     Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ایندکس‌های حیاتی برای صفحات آرشیو، فیلتر نوع محتوا، جدیدترین‌ها و پربازدیدترین‌ها
  @@index([status, type, publishedAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([type, status, viewCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([titleBase])
}

// ================================================
// جداول ساختار تعاملات و نظرات
// ================================================
model Comment {
  id     String @id @default(cuid())
  text   String
  status String @default("PENDING") // جایگزین enum CommentStatus

  adminReply String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ایندکس واکشی نظرات تاییدشده یک محتوا
  @@index([contentId, status, createdAt(sort: Desc)])
  // ایندکس پنل مدیریت برای بررسی نظرات در انتظار تایید (PENDING)
  @@index([status, createdAt(sort: Desc)])
  // ایندکس بررسی Rate Limit کاربر و نمایش نظرات کاربر در حساب کاربری
  @@index([userId, createdAt(sort: Desc)])
}

// ------------------------------------------------
// جدول ذخیره آمار کاوش‌های کاربران (Search Analytics)
// ------------------------------------------------
model SearchLog {
  id           String   @id @default(cuid())
  keyword      String
  resultsCount Int
  
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())

  // ایندکس‌های تحلیل عبارات پرتکرار، کاوش‌های بی‌نتیجه و جلوگیری از اسپم جستجو
  @@index([keyword, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([resultsCount])
  @@index([createdAt])
}

// ------------------------------------------------
// جدول لاگ و تاریخچه کدهای تایید (برای روز مبادا و بررسی مسئول)
// ------------------------------------------------
model OtpLog {
  id        String   @id @default(cuid())
  phone     String   // شماره موبایل درخواست دهنده
  code      String   // کد تولید شده (گذرواژهنگاری‌شده یا ماسک‌شده پس از مصرف)
  purpose   String   // جایگزین enum OtpPurpose (REGISTER, LOGIN, FORGOT_PASSWORD)
  isSuccess Boolean  @default(true) // آیا پیامک با موفقیت تحویل سامانه شد؟
  isUsed    Boolean  @default(false) // آیا کاربر با این کد ورود/ثبت‌نام موفقی داشت؟
  errorMsg  String?  // در صورت قطعی، خطای سامانه پیامک اینجا ذخیره می‌شود
  
  createdAt DateTime @default(now()) // زمان دقیق درخواست

  // ایندکس بررسی Rate Limit شماره موبایل و گزارش‌گیری پنل مدیریت
  @@index([phone, createdAt(sort: Desc)])
  @@index([purpose, isSuccess, createdAt(sort: Desc)])
  @@index([createdAt])
}